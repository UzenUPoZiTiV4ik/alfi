# Секреты
.env
server/.env

# Данные кейса: у каждого свои, в репозиторий не входят
server/data/raw/*
!server/data/raw/.gitkeep
server/data/kb/pdf/*
!server/data/kb/pdf/.gitkeep
server/data/kb/*.json
server/data/*.db
server/data/*.db-*

# Окружение и кэши
.venv/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.DS_Store
