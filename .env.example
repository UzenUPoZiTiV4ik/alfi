# Скопируйте в .env и заполните ключи
LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
LLM_API_KEY=
EXA_API_KEY=
# Подпись сессий: любая длинная случайная строка, например: openssl rand -hex 32
SESSION_SECRET=

# Необязательно
# BUDGET_SOFT_RUB=120        # после порога новые глубокие разборы не стартуют
# BUDGET_HARD_RUB=450        # после порога вызовы моделей останавливаются
# INGEST_INTERVAL_MIN=60     # автосбор новостей, 0 выключает
# INGEST_USE_EXA=true

# Пароль на весь сайт. Пусто — вход не спрашивается.
# SITE_PASSWORD=change-me
# SITE_BASE=/alfi          # если приложение живёт под путём
# SITE_COOKIE_TTL_H=168
