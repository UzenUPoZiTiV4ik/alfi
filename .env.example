# Скопируйте в .env и заполните ключи
LLM_BASE_URL=https://alfahack-gateway26.ru/v1
LLM_API_KEY=
EXA_API_KEY=
# Подпись сессий: любая длинная случайная строка, например: openssl rand -hex 32
SESSION_SECRET=

# Режим рассуждений: false (быстро и дёшево, 51,6 с / 0,86 ₽) или selective + low (77,9 с / 1,14 ₽, 100% цифр)
# LLM_REASONING=false
# LLM_REASONING_PURPOSES=synth,repair
# LLM_REASONING_EFFORT=low

# Локальный compose включает демо по умолчанию. Для продакшена укажите 0.
# ALFI_DEMO_MODE=1
# ADMIN_API_TOKEN=
# LLM_MAX_CONCURRENCY=4
# LLM_MAX_RUB_PER_1K=0.5
# ALFI_FROZEN_NOW=2026-10-26T20:30:00Z  # дата новостей для seed_demo.py

# Необязательно
# BUDGET_SOFT_RUB=120        # после порога новые глубокие разборы не стартуют
# BUDGET_HARD_RUB=450        # после порога вызовы моделей останавливаются
# INGEST_INTERVAL_MIN=60     # автосбор новостей, 0 выключает
# INGEST_USE_EXA=true

# Пароль на весь сайт. Пусто — вход не спрашивается.
# SITE_PASSWORD=change-me
# SITE_BASE=/alfi          # если приложение живёт под путём
# SITE_COOKIE_TTL_H=168
